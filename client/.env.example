# ── Sidra Client Environment Variables ──────────────────────────────────────
#
# Copy this file to .env for local development.
# For production, set these in Vercel → Project Settings → Environment Variables.
#
# NEVER commit .env (with real values) to version control.
# This .env.example file is safe to commit — it contains placeholder values only.
#
# ── REST API ─────────────────────────────────────────────────────────────────
# The full URL of the Express backend on Render.
# Leave UNSET in local dev — the Vite proxy handles /api/* automatically.
# Set this ONLY in Vercel (production):
VITE_API_URL=https://sidra-api-or0n.onrender.com

# ── Socket.IO ────────────────────────────────────────────────────────────────
# The Socket.IO server URL (same as the backend).
# Vite's proxy does not reliably forward WebSocket upgrades, so socket.io-client
# connects here directly in both dev and production.
#   local dev:   http://localhost:5000
#   production:  https://sidra-api-or0n.onrender.com
VITE_SOCKET_URL=https://sidra-api-or0n.onrender.com
