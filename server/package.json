{
  "name": "sidra-server",
  "version": "0.1.0",
  "description": "Sidra backend — Node.js + Express REST API",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "migrate": "node src/db/migrate.js",
    "test": "node tests/auth.test.js",
    "test:profile": "node tests/profile.test.js",
    "test:admin": "node tests/admin.test.js",
    "test:courses": "node tests/courses.test.js",
    "test:all": "node tests/auth.test.js && node tests/profile.test.js && node tests/admin.test.js && node tests/courses.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "node-fetch": "^3.3.2",
    "socket.io-client": "^4.8.1"
  }
}
