# ============================================================
# Sidra Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# This .env.example file is safe to commit — it contains
# only placeholder values, not real secrets.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────
# The URL of the React frontend (Vite dev server default)
CLIENT_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────────
# Full PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example (local): postgresql://postgres:yourpassword@localhost:5432/sidra_db
# Leave empty until PostgreSQL is set up.
DATABASE_URL=

# ── Authentication ────────────────────────────────────────────
# A long, random string used to sign JWT tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER use a short or guessable value in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
