# ============================================================
# Sidra Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in your own values.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Mac / Linux:           cp .env.example .env
#
# NEVER commit .env to version control.
# This .env.example file is safe to commit — it contains
# placeholder values only, not real secrets.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────
# The URL of the React frontend (Vite dev server default)
CLIENT_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────────
# Individual PostgreSQL connection parameters.
# DB_HOST     — usually localhost for a local install
# DB_PORT     — default PostgreSQL port is 5432
# DB_NAME     — the database you created (e.g. sidra_db)
# DB_USER     — your PostgreSQL username (e.g. postgres)
# DB_PASSWORD — the password you set when installing PostgreSQL

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sidra_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Authentication (add when auth is implemented) ─────────────
# Generate SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER use a short or guessable value in production.
SESSION_SECRET=your_long_random_secret_here
SESSION_DURATION_DAYS=7

# ── Cloudinary (media uploads) ───────────────────────────────────────────────
# Sign up free at https://cloudinary.com/
# Find these values in Cloudinary Console → Settings → API Keys
#
# NEVER commit your real API secret.
# These placeholder values are safe to commit.
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
