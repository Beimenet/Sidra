# ============================================================
# Sidra — Root .gitignore
# Covers both client/ and server/ workspaces
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build output ─────────────────────────────────────────────
client/dist/
client/build/

# ── Environment variables — NEVER commit real secrets ────────
.env
.env.local
.env.production
.env.staging
**/.env
**/.env.local

# .env.example files are safe to commit (placeholders only)
!.env.example
!**/.env.example

# ── OS and editor artefacts ───────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json
.idea/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Misc ──────────────────────────────────────────────────────
*.pem
.cache/
